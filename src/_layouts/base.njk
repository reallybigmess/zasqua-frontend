{#
  Base Layout

  The outermost HTML wrapper used by every page on the site. It sets the
  document language from `site.language`, composes the page title as
  "Page Title | Site Title", wires up the meta description, favicon, and
  Google Fonts (DM Sans, Crimson Text, Cormorant Garamond, and the
  Material Symbols icon set), and loads the compiled `main.css`.

  The body includes the shared header and footer partials and exposes
  three Nunjucks blocks that child templates can extend —  `head` for
  per-page stylesheets (the TIFY viewer CSS on IIIF pages, for example),
  `content` for the page body, and `scripts` for per-page scripts (tree,
  search, entity, place, description). The Cloudflare Web Analytics
  beacon is loaded at the end of the body.

  Version: v0.4.0
#}
<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" type="image/png" href="/img/favicon.png">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600&family=Crimson+Text:wght@400;700&family=Cormorant+Garamond:wght@300;600&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/main.css">

  {% block head %}{% endblock %}
</head>
<body class="bg-bg font-sans text-stone-600">
  {% include "header.njk" %}

  <main class="page-content">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  {% include "footer.njk" %}

  <script src="/js/header.js"></script>
  {% block scripts %}{% endblock %}

  <!-- Cloudflare Web Analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "bd05fe4ac01547849248727c0598306e"}'></script>
  <!-- End Cloudflare Web Analytics -->
</body>
</html>
