---
pagination:
  data: repositories
  size: 1
  alias: repo
permalink: "/{{ repo.code }}/"
layout: base.njk
---

{% set repoTitle = repo.name %}
{% set repoImage = "/img/repo/"+repo.code+".jpg" %}
{% set repoSubtitle = repo.notes %}
{% set repoLink = "/" + repo.code + "/" %}

<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <a href="/" class="text-sm text-stone-400 hover:text-burgundy-light">{{ ui.nav.home }}</a>
    <span class="breadcrumb-separator text-stone-400">›</span>
    <span class="text-sm text-stone-500">{{ repoTitle }}</span>
  </div>
</nav>

<section class="repo-header" style="background-image: url('{{ repoImage }}');">
  <div class="repo-header-overlay">
    <div class="container">
      <h1 class="repo-header-title font-sans text-white">{{ repoTitle }}</h1>
      {% if repoSubtitle %}
        <p class="repo-header-subtitle text-white">{{ repoSubtitle }}</p>
      {% endif %}
      <p class="repo-header-stats text-stone-300">{{ (repo.description_count or 0) | numberFormat }} {{ ui.repository.itemsCount }}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    {# Search link above tree #}
    <div class="tree-header">
      <a href="/buscar/?ancestor={{ repo.code }}" class="search-collection-link">
        <span class="material-symbols-outlined">search</span>
        Buscar en esta colección
      </a>
    </div>

    {# Miller columns tree container #}
    {% if repo.root_descriptions and repo.root_descriptions.length > 0 %}
      <div id="collection-tree"
           data-repo-code="{{ repo.code }}"
           data-level-labels='{{ ui.levelsPlural | dump | safe }}'>
      </div>

      {# Embed root descriptions as JSON for initial load #}
      <script type="application/json" id="root-descriptions-data">
        {{ repo.root_descriptions | dump | safe }}
      </script>
    {% else %}
      <p class="text-muted text-center">{{ ui.repository.noCollections }}</p>
    {% endif %}
  </div>
</section>

<script src="/js/tree.js"></script>
