{#
  Entity Detail Page

  Renders one page per authority record for a person or institution — the
  "who" behind the archival material. Eleventy iterates over the entities
  loaded by `src/_data/entities.js` and produces a page at
  `/entidad/{entity_code}/` for each one.

  The left column shows identity metadata following the ISAAR(CPF)
  standard — authorised name, structured name parts, name variants,
  dates of existence, primary function or office, and biographical
  history. Linked documents are loaded lazily at runtime by
  `js/entity.js`, which calls the backend API at
  `/api/entities/{entity_code}/descriptions/` so the list stays current
  without requiring a full rebuild of the static site.

  Version: v0.4.0
#}
---
pagination:
  data: entities
  size: 1
  alias: entity
permalink: "/entidad/{{ entity.entity_code }}/"
layout: base.njk
eleventyComputed:
  title: "{{ entity.display_name }}"
---

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>{{ entity.display_name }}</span>
  </div>
</nav>

{# Header #}
<div class="detail-header" data-pagefind-body>
  <div class="container">
    <h1 class="detail-title font-sans font-semibold text-stone-900">{{ entity.display_name }}</h1>
    <div class="detail-meta text-sm text-stone-500">
      <span class="level-badge">{% if entity.entity_type == 'person' %}Persona{% else %}Institución{% endif %}</span>
      {% if entity.date_earliest or entity.date_latest %}
        &middot;
        {% if entity.date_earliest %}{{ entity.date_earliest }}{% endif %}
        {% if entity.date_earliest and entity.date_latest %}&ndash;{% endif %}
        {% if entity.date_latest %}{{ entity.date_latest }}{% endif %}
      {% endif %}
      &middot; {{ entity.entity_code }}
    </div>
  </div>
</div>

{# Detail content #}
<div class="detail-content">
  <div class="container">
    <div class="desc-layout">

      {# Left column: metadata #}
      <div class="desc-metadata" data-pagefind-body>

        {# Section: Nombre #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">Identificación</h3>

          {% if entity.display_name %}
            <div class="detail-field">
              <span class="detail-label font-semibold text-stone-900">Nombre autorizado</span>
              <span class="detail-value text-stone-700">{{ entity.display_name }}</span>
            </div>
          {% endif %}

          {% if entity.given_name or entity.particle or entity.surname %}
            <div class="detail-field">
              <span class="detail-label font-semibold text-stone-900">Nombre estructurado</span>
              <span class="detail-value text-stone-700">
                {% if entity.honorific %}{{ entity.honorific }} {% endif %}
                {% if entity.given_name %}{{ entity.given_name }} {% endif %}
                {% if entity.particle %}{{ entity.particle }} {% endif %}
                {% if entity.surname %}{{ entity.surname }}{% endif %}
              </span>
            </div>
          {% endif %}

          {% if entity.name_variants and entity.name_variants.length > 0 %}
            <div class="detail-field">
              <span class="detail-label font-semibold text-stone-900">Variantes del nombre</span>
              <ul class="detail-value detail-list">
                {% for variant in entity.name_variants %}
                  <li>{{ variant }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if entity.date_earliest or entity.date_latest %}
            <div class="detail-field">
              <span class="detail-label font-semibold text-stone-900">Fechas de existencia</span>
              <span class="detail-value text-stone-700">
                {% if entity.dates_of_existence %}
                  {{ entity.dates_of_existence }}
                {% else %}
                  {% if entity.date_earliest %}{{ entity.date_earliest }}{% endif %}
                  {% if entity.date_earliest and entity.date_latest %}&ndash;{% endif %}
                  {% if entity.date_latest %}{{ entity.date_latest }}{% endif %}
                {% endif %}
              </span>
            </div>
          {% endif %}

          {% if entity.primary_function %}
            <div class="detail-field">
              <span class="detail-label font-semibold text-stone-900">Función o cargo</span>
              <span class="detail-value text-stone-700">{{ entity.primary_function }}</span>
            </div>
          {% endif %}

          {% if entity.history %}
            <div class="detail-field">
              <span class="detail-label font-semibold text-stone-900">Historia</span>
              <span class="detail-value text-stone-700">{{ entity.history }}</span>
            </div>
          {% endif %}

        </div>

      </div>

    </div>

    {# Linked descriptions — full width #}
    <div class="detail-section" data-pagefind-ignore>
      <h3>Documentos relacionados</h3>
      <div id="entity-descriptions"
           data-entity-code="{{ entity.entity_code }}"
           data-api-url="/api/entities/{{ entity.entity_code }}/descriptions/">
        <p class="text-stone-400 text-sm">Cargando documentos...</p>
      </div>
    </div>

  </div>
</div>

{% block scripts %}
  <script src="/js/entity.js"></script>
{% endblock %}
