{#
  Place Explorer Page

  Renders the `/lugares/` page — a map-centric interface for browsing
  the ~7,000 geographic entities named across the Zasqua catalogue.
  The page is split into two rows. The top row holds a MapLibre GL map
  with clustered burgundy markers and a sticky selected-place card on
  the right. The bottom row holds the filter column (viewport toggle,
  search input, place-type facets, coordinate availability, external
  authority presence) on the left and a paginated place index on the
  right.

  The template loads MapLibre GL and Protomaps basemaps from CDN,
  primes the grid layout, and boots `place-explorer.js`, which does
  all the heavy lifting — cluster rendering, Pagefind-backed search,
  viewport-scoped filtering, and cross-panel selection sync.

  Version: v0.5.0
#}
---
layout: base.njk
title: "Explorar lugares"
permalink: /lugares/
---

{% block head %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" />
  <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.js"></script>
  <script src="https://unpkg.com/@protomaps/basemaps@5/dist/basemaps.js" crossorigin="anonymous"></script>
{% endblock %}

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>Explorar lugares</span>
  </div>
</nav>

<div class="explorer-page" data-pagefind-ignore>

  {# Page header #}
  <header class="explorer-page-header">
    <h1 class="explorer-page-title">Explorar lugares</h1>
    <p class="explorer-page-intro">
      Explora los <strong id="place-count-live">{{ places | length | numberFormat }}</strong> lugares vinculados a las descripciones de Zasqua. Busca por nombre, filtra por tipo o selecciona un lugar en el mapa.
      Prueba con
      <button type="button" class="graph-empty-state-link" data-place="santafe-de-bogota">Santaf&eacute; de Bogot&aacute;</button>,
      <button type="button" class="graph-empty-state-link" data-place="cartagena">Cartagena</button>,
      <button type="button" class="graph-empty-state-link" data-place="quito">Quito</button>
      o
      <button type="button" class="graph-empty-state-link" data-place="popayan">Popay&aacute;n</button>.
    </p>
  </header>

  {# Two-row grid:
       Row 1 — map panel (spans filters+results columns) | selected place card
       Row 2 — filters | place index (results spans results+selected) #}
  <div class="explorer-grid">

    {# Row 1 left — map panel #}
    <section class="explorer-graph-panel">

      <div id="explorer-map" style="width:100%;height:100%"></div>

    </section>

    {# Row 1 right — selected place card (sticky) #}
    <aside class="explorer-selected-col">
      <div id="selected-place-card" class="selected-entity-card">
        <div class="selected-entity-stub">Selecciona un lugar para ver más detalles</div>
      </div>
    </aside>

    {# Row 2 left — filters #}
    <aside class="explorer-filters-col">
      {# Filter-by-viewport toggle — sits above the search bar so it's
         visually adjacent to the map (top row) it filters from. The
         vertical-arrows icon symbolises the link between the map above
         and the place index below. #}
      <button type="button"
              id="viewport-filter-toggle"
              class="viewport-filter-btn"
              aria-pressed="false">
        <svg class="viewport-filter-icon" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M5 2.5 L5 13.5 M2.5 5 L5 2.5 L7.5 5 M11 13.5 L11 2.5 M8.5 11 L11 13.5 L13.5 11"
                stroke="currentColor" stroke-width="1.6" fill="none"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="viewport-filter-label">Filtrar por vista del mapa</span>
      </button>

      {# Search input — filled by JS #}
      <div id="place-search-input" class="explorer-filter-search"></div>

      {# Facets (place type, coords, authority) — filled by JS #}
      <div id="sidebar-facets"></div>
    </aside>

    {# Row 2 right — results (spans results + selected columns) #}
    <div class="explorer-results-col">
      {# Search results, active filter pills, sort, pagination #}
      <div id="place-explorer"
           data-place-types='{{ ui.place.types | dump | safe }}'
           data-protomaps-key='{{ site.protomaps_key }}'></div>
    </div>

  </div>

</div>

{% block scripts %}
  <script src="/js/place-explorer.js"></script>
{% endblock %}
