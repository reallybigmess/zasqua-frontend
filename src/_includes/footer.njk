  <div class="container">
    <div class="footer-left text-sm">
      <p>Zasqua developed by <a href="https://neogranadina.org" target="_blank" class="text-white font-semibold hover:text-periwinkle">Neogranadina</a> and the <a href="https://ampl.clair.ucsb.edu" target="_blank" class="text-white font-semibold hover:text-periwinkle">Archives, Memory, and Preservation Lab (AMPL)</a> at UCSB.</p>
      <p class="footer-copyright">{{ ui.footer.copyright | replace("{year}", site.buildYear) }}.
      <br><a href="https://github.com/neogranadina/zasqua-frontend/releases/tag/v{{ site.version }}" class="text-white hover:text-periwinkle">Zasqua v{{ site.version }}</a>. Last build date: {{ site.buildDate }}.</p>
    </div>
    <div class="footer-right">
      <img src="{% if baseUrl %}{{ baseUrl }}{% else %}{% endif %}/img/logo_grande.svg" style="width:25%; height:25%;" alt="Neogranadina" class="footer-seal">
      <img src="{% if baseUrl %}{{ baseUrl }}{% else %}{% endif %}/img/ampl-cropped-1.png" style="width:25%; height:25%;" alt="AMP Lab, UC Santa Barbara" class="footer-seal">
    </div>
  </div>
