{#
  Breadcrumb Partial

  A small reusable trail of links that sits below the site header on
  pages with a clear hierarchy. The partial expects a `breadcrumbs`
  array in context — each entry with a `title` and optional `url` —
  and always prepends a link home using the `ui.breadcrumb.home` label.
  Entries without a URL are rendered as plain text, which is how the
  current page is indicated.

  Currently kept as a shared include for pages that need arbitrary
  breadcrumb chains; the description, entity, place, and repository
  templates render their own inline breadcrumbs tailored to their
  specific hierarchy.

  Version: v0.1.0
#}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    {% for crumb in breadcrumbs %}
      <span class="breadcrumb-separator">&rsaquo;</span>
      {% if crumb.url %}
        <a href="{{ crumb.url }}">{{ crumb.title }}</a>
      {% else %}
        <span>{{ crumb.title }}</span>
      {% endif %}
    {% endfor %}
  </div>
</nav>
