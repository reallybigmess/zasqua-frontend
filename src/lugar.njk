---
pagination:
  data: places
  size: 1
  alias: place
permalink: "/{{ place.place_code }}/"
layout: base.njk
eleventyComputed:
  title: "{{ place.display_name }}"
---

{#
  Place Detail Page

  Renders one page per place authority record — the geographic referents
  (cities, regions, rivers, parishes) that appear in the archival
  material. Eleventy iterates over the places loaded by
  `src/_data/places.js` and produces a page at `/nl-{id}/` for each one.

  The page has three roles:

    1. Display the place authority record — name, variants, country,
       external identifiers (Wikidata, Getty TGN, World Historical
       Gazetteer, HGIS de las Indias) and coordinates.
    2. Feed the place explorer's Pagefind index with hidden
       `data-pagefind-filter`, `-sort`, and `-meta` spans covering
       place type, coordinate availability, external authority
       presence, so the place shows up correctly in explorer facets.
    3. Show the linked documents in a scrollable list under the map,
       with a sort toggle between chronological (default, with
       undated items grouped under "Sin fecha") and alphabetical by
       title. When the place has no coordinates the map frame is
       replaced with a polite "Ubicación no disponible" notice that
       matches the not-digitised placeholder used on description
       pages.

  Version: v0.5.0
#}

{# Coordinate-less singletons are excluded from the place explorer
   and pagefind-places index — they add noise without useful discovery.
   The page itself still exists for direct linking from descriptions. #}
{% set _in_explorer = (place.latitude and place.longitude) or place._linked_count > 1 %}

{% if _in_explorer %}
{# Pagefind metadata for place index #}
<div style="display:none">
  <span data-pagefind-filter="place_type">{{ place.place_type }}</span>
  <span data-pagefind-filter="has_coordinates">{% if place.latitude and place.longitude %}true{% else %}false{% endif %}</span>
  <span data-pagefind-filter="has_authority">{% if place.wikidata_id or place.whg_id or place.tgn_id or place.hgis_id %}true{% else %}false{% endif %}</span>
  <span data-pagefind-sort="name">{{ place.display_name }}</span>
  <span data-pagefind-meta="place_type">{{ place.place_type }}</span>
  <span data-pagefind-meta="has_coordinates">{% if place.latitude and place.longitude %}true{% else %}false{% endif %}</span>
  <span data-pagefind-meta="linked_count">{{ place._linked_count }}</span>
  {% if place.name_variants and place.name_variants.length %}
    <span data-pagefind-meta="name_variants">{{ place.name_variants | join(', ') }}</span>
  {% endif %}
</div>
<div data-pagefind-body style="display:none">
  {{ place.display_name }}
  {% if place.name_variants %}{{ place.name_variants | join(' ') }}{% endif %}
</div>
{% endif %}

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore data-pagefind-place-page>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>{{ ui.place.breadcrumbParent }}</span>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>{{ place.display_name }}</span>
  </div>
</nav>

{# Header #}
<div class="detail-header" data-pagefind-ignore>
  <div class="container">
    <h1 class="detail-title font-sans font-semibold text-stone-900">{{ place.display_name }}</h1>
    <div class="detail-meta text-sm text-stone-500">
      <span class="level-badge">{{ ui.place.types[place.place_type] or place.place_type }}</span>
    </div>
  </div>
</div>

{# Two-column layout #}
<div class="detail-content" data-pagefind-ignore>
  <div class="container">
    <div class="desc-layout entity-layout">

      {# Left column: metadata #}
      <div class="desc-metadata">

        {# Section: Identificacion #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.sections.identification }}</h3>

          <div class="detail-field">
            <span class="detail-label">{{ ui.place.fields.name }}</span>
            <span class="detail-value">{{ place.display_name }}</span>
          </div>

          {% if place.name_variants and place.name_variants.length %}
            <div class="detail-field">
              <span class="detail-label">{{ ui.place.fields.nameVariants }}</span>
              <span class="detail-value">{{ place.name_variants | join(', ') }}</span>
            </div>
          {% endif %}

          {% if place.country_code %}
            <div class="detail-field">
              <span class="detail-label">{{ ui.place.fields.countryCode }}</span>
              <span class="detail-value">{{ place.country_code | countryName }}</span>
            </div>
          {% endif %}
        </div>

        {# Section: Identificadores externos (only if at least one authority ID present) #}
        {% if place.wikidata_id or place.whg_id or place.tgn_id or place.hgis_id %}
          <div class="detail-section">
            <h3 class="font-semibold text-stone-400">{{ ui.place.sections.externalIds }}</h3>
            <div class="authority-rows">
              {% if place.wikidata_id %}
                <a href="https://www.wikidata.org/wiki/{{ place.wikidata_id }}" target="_blank" rel="noopener" class="authority-row">
                  <span class="material-symbols-outlined authority-row-icon">open_in_new</span>
                  <span class="authority-row-label">Wikidata</span>
                  <span class="authority-row-code">{{ place.wikidata_id }}</span>
                </a>
              {% endif %}
              {% if place.tgn_id %}
                <a href="https://vocab.getty.edu/page/tgn/{{ place.tgn_id }}" target="_blank" rel="noopener" class="authority-row">
                  <span class="material-symbols-outlined authority-row-icon">open_in_new</span>
                  <span class="authority-row-label">TGN</span>
                  <span class="authority-row-code">{{ place.tgn_id }}</span>
                </a>
              {% endif %}
              {% if place.whg_id %}
                <a href="https://whgazetteer.org/places/{{ place.whg_id }}/portal" target="_blank" rel="noopener" class="authority-row">
                  <span class="material-symbols-outlined authority-row-icon">open_in_new</span>
                  <span class="authority-row-label">WHG</span>
                  <span class="authority-row-code">{{ place.whg_id }}</span>
                </a>
              {% endif %}
              {% if place.hgis_id %}
                <div class="authority-row authority-row-static">
                  <span class="authority-row-label">HGIS</span>
                  <span class="authority-row-code">{{ place.hgis_id }}</span>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}


        {# Section: Control #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.sections.control }}</h3>
          <div class="detail-field">
            <span class="detail-label">{{ ui.place.fields.placeCode }}</span>
            <span class="detail-value detail-value-mono">{{ place.place_code or ("nl-" + place.id) }}</span>
          </div>
          {% if place.latitude and place.longitude %}
            <div class="detail-field">
              <span class="detail-label">{{ ui.place.fields.coordinates }}</span>
              <span class="detail-value">{{ place.latitude }}, {{ place.longitude }}</span>
            </div>
          {% endif %}
          {% if _in_explorer %}
          <div class="detail-field">
            <a href="/lugares/?q={{ place.display_name | urlencode }}"
               class="inline-flex items-center gap-1.5 text-sm font-medium rounded-md transition-colors"
               style="padding:0.5rem 1rem;background:var(--color-burgundy);color:#fff"
               onmouseover="this.style.background='var(--color-burgundy-deep)'"
               onmouseout="this.style.background='var(--color-burgundy)'">
              <span class="material-symbols-outlined" style="font-size:16px">location_on</span>
              Ver en explorador
            </a>
          </div>
          {% endif %}
        </div>

        {# Section: Reutilizacion #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.sections.reuse }}</h3>
          <p class="reuse-blurb">Zasqua se inspira en los <a href="https://journal.code4lib.org/articles/13427" target="_blank" rel="noopener">principios FAIR</a> para hacer sus registros de autoridad más abiertos y reutilizables. Utiliza el formato <a href="https://github.com/LinkedPasts/linked-places-format" target="_blank" rel="noopener">Linked Places</a> para publicar registros geográficos en formato interoperable.</p>
          <div class="reuse-manifest">
            <strong class="reuse-manifest-label">Linked Places</strong>
            <div class="reuse-manifest-row">
              <code class="reuse-manifest-url reuse-coming-soon">Disponible próximamente</code>
            </div>
          </div>
        </div>

      </div>

      {# Right column: aside with map and description list #}
      <div class="desc-aside">
        <div class="detail-section">
          {# Map — always visible when coordinates exist #}
          {% if place.latitude and place.longitude %}
            <h3 class="font-semibold text-stone-400">{{ ui.place.map }}</h3>
            <div class="place-map-frame" id="place-map-frame">
              <div class="place-map" id="place-map"
                   data-lat="{{ place.latitude }}"
                   data-lon="{{ place.longitude }}"
                   data-place-name="{{ place.display_name }}"
                   data-place-type="{{ ui.place.types[place.place_type] or place.place_type }}"
                   data-protomaps-key="{{ site.protomaps_key }}"></div>
            </div>
          {% else %}
            <div class="desc-notice">
              <span class="material-symbols-outlined desc-notice-icon">location_off</span>
              <div class="desc-notice-title">{{ ui.place.noCoordinatesTitle }}</div>
              <p class="desc-notice-text">{{ ui.place.noCoordinatesText }}</p>
            </div>
          {% endif %}

          <h3 class="font-semibold text-stone-400">{{ ui.place.linkedDescriptions }}</h3>

          <div class="entity-role-filters" id="place-role-filters"></div>

          {# Description list with sort toggle #}
          <div id="place-description-list-wrapper">
            <div id="place-description-sort" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
              <span class="text-sm font-medium text-stone-700" id="place-desc-count"></span>
              <div class="sort-controls" style="display:flex;gap:0.5rem;align-items:center">
                <button type="button" class="sort-btn active" data-sort="chronological">Cronol&oacute;gico</button>
                <span class="sort-divider">|</span>
                <button type="button" class="sort-btn" data-sort="alphabetical">Alfab&eacute;tico</button>
              </div>
            </div>
            <div id="place-timeline" data-place-id="{{ place.place_code }}">
              <p class="text-stone-500 text-sm">{{ ui.general.loading }}</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

{% block head %}
  {% if place.latitude and place.longitude %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" />
    <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.js"></script>
    <script src="https://unpkg.com/@protomaps/basemaps@5/dist/basemaps.js" crossorigin="anonymous"></script>
  {% endif %}
{% endblock %}

{% block scripts %}
  <script src="/js/place.js"></script>
{% endblock %}
