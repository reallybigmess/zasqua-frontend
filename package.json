{
  "name": "zasqua-frontend",
  "version": "1.0.0",
  "description": "Zasqua archival catalog frontend",
  "scripts": {
    "dev": "hugo server --bind 127.0.0.1 --port 1313",
    "build": "./build.sh",
    "build:dev": "SKIP_DOWNLOAD=1 DEV_LIMIT=100 ./build.sh",
    "enrich": "node scripts/generate-content.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "archive",
    "catalog",
    "hugo"
  ],
  "author": "Neogranadina",
  "license": "GPL-3.0-only",
  "homepage": "https://zasqua.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/neogranadina/zasqua-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/neogranadina/zasqua-frontend/issues"
  },
  "devDependencies": {
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "pagefind": "^1.5.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
