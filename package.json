{
  "name": "zasqua",
  "version": "1.0.0",
  "description": "Zasqua: open-source archival platform for hosting and discovering digitized historical documents.",
  "scripts": {
    "dev": "hugo server --bind 127.0.0.1 --port 1313",
    "build": "SKIP_DOWNLOAD=1 ./build.sh",
    "build:dev": "SKIP_DOWNLOAD=1 DEV_LIMIT=100 ./build.sh",
    "enrich": "node scripts/generate-content.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "archive",
    "catalog",
    "hugo"
  ],
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Juan Cobo Betancourt",
    "email": "juan@neogranadina.org"
  },
  "contributors": [
    { "name": "Archives, Memory, and Preservation Lab, University of California, Santa Barbara" },
    { "name": "Neogranadina" }
  ],
  "homepage": "https://zasqua.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/neogranadina/zasqua.git"
  },
  "bugs": {
    "url": "https://github.com/neogranadina/zasqua/issues"
  },
  "devDependencies": {
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "pagefind": "^1.5.2",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
